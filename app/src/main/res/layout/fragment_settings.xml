<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".settings.SettingsFragment">


    <data>
        <variable
            name="viewModel"
            type="com.eminokumus.bookvox.settings.SettingsViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/white"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/settings"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <View
        android:id="@+id/firstDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_grey"
        app:layout_constraintTop_toBottomOf="@id/backButton" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/userImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="20dp"
        app:imageUrl="@{viewModel.user.component6()}"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:shapeAppearanceOverlay="@style/settingsImageRoundedImageView"
        tools:src="@drawable/ic_launcher_background" />

    <TextView
        android:id="@+id/userNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/poppins"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="@{viewModel.user.component2()}"
        app:layout_constraintBottom_toTopOf="@id/viewProfileButtonText"
        app:layout_constraintStart_toEndOf="@id/userImage"
        app:layout_constraintTop_toTopOf="@id/userImage"
        tools:text="John Doe" />

    <TextView
        android:id="@+id/viewProfileButtonText"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/view_profile"
        android:textColor="@color/primary_purple"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/userImage"
        app:layout_constraintStart_toStartOf="@id/userNameText"
        app:layout_constraintTop_toBottomOf="@id/userNameText" />

    <View
        android:id="@+id/secondDivider"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:background="@color/light_grey"
        app:layout_constraintTop_toBottomOf="@id/userImage" />

    <TextView
        android:id="@+id/notificationsText"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:fontFamily="@font/poppins"
        android:gravity="center|start"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/notifications"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/secondDivider" />

    <View
        android:id="@+id/thirdDivider"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@color/light_grey"
        app:layout_constraintTop_toBottomOf="@id/notificationsText" />

    <TextView
        android:id="@+id/subscriptionText"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:fontFamily="@font/poppins"
        android:gravity="center|start"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/subscription"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/thirdDivider" />

    <View
        android:id="@+id/fourthDivider"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@color/light_grey"
        app:layout_constraintTop_toBottomOf="@id/subscriptionText" />

    <TextView
        android:id="@+id/aboutBookVoxText"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:fontFamily="@font/poppins"
        android:gravity="center|start"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/about_bookvox"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fourthDivider" />

    <View
        android:id="@+id/fifthDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_grey"
        app:layout_constraintTop_toBottomOf="@id/aboutBookVoxText" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="@string/log_out"
        android:textColor="@color/orange"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_medium"
        android:background="@drawable/bg_orange_borderline"
        app:backgroundTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fifthDivider" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>